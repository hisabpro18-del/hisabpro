PORT=3001
# cloud (Postgres) or desktop (SQLite, set by the Electron app)
MODE=cloud
DATABASE_URL=postgresql://postgres:postgres@localhost:54330/hisabpro?schema=public
# migrations connect here (on Supabase: the session pooler, port 5432); locally the same database
DIRECT_URL=postgresql://postgres:postgres@localhost:54330/hisabpro?schema=public
# npm run gen:keys
JWT_SECRET=
# npm run seed creates the one super admin from these
SUPER_ADMIN_EMAIL=admin@hisabpro.local
SUPER_ADMIN_PASSWORD=
# how many days a desktop PC may stay offline before it must connect
DESKTOP_OFFLINE_DAYS=7
