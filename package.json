{
  "name": "hisabpro",
  "version": "0.1.0",
  "private": true,
  "description": "HisabPro — multi-tenant POS with khata, inventory, finance and HRM; web + offline Windows desktop app with sync",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:local": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "seed:demo": "node scripts/seed-demo.js",
    "build": "npm run build:css && npm run build:vendor && prisma generate",
    "build:css": "tailwindcss -i styles/app.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i styles/app.css -o public/css/app.css --watch",
    "build:vendor": "node scripts/vendor.js",
    "build:sqlite": "node scripts/gen-sqlite.js",
    "gen:keys": "node -e \"console.log('JWT_SECRET='+require('crypto').randomBytes(48).toString('hex'))\"",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "desktop": "electron .",
    "desktop:build": "npm run build && npm run build:sqlite && electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.hisabpro.desktop",
    "productName": "HisabPro",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "server.js",
      "src/**",
      "public/**",
      "package.json",
      "node_modules/**",
      "!node_modules/.prisma/**",
      "!node_modules/@prisma/engines/**",
      "!node_modules/prisma/**",
      "desktop/main.js",
      "desktop/preload.js",
      "desktop/config.json",
      "desktop/schema.sql",
      "desktop/icon.png"
    ],
    "asarUnpack": [
      "src/generated/sqlite/**"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "HisabPro"
    },
    "icon": "desktop/icon.png"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@tailwindcss/cli": "^4.1.0",
    "chart.js": "^4.5.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "jsbarcode": "^3.12.1",
    "prisma": "^6.19.0",
    "qrcode-generator": "^1.4.4",
    "tailwindcss": "^4.1.0"
  }
}
